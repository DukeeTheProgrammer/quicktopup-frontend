{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quicktopup.it.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://quicktopup.it.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://quicktopup.it.com/admin/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
