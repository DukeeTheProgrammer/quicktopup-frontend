{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bydcarss.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "https://bydcarss.com/admin/"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://bydcarss.com/admin/$1"
    },
    {
      "source": "/((?!api/|admin/).*)",
      "destination": "/index.html"
    }
  ]
}
